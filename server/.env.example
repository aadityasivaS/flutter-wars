# Application
APP_NAME=GDG Flutter Workshop Backend
ENVIRONMENT=development
LOG_LEVEL=INFO

# Use a local PostgreSQL URL for development, or the Cloudflare Hyperdrive URL in deployment.
# Do not commit real credentials. SQLModel expects a SQLAlchemy-compatible URL.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
